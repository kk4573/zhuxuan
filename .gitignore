# ==================== 绝不进版本库 ====================

# 含 API Key（sk-… 只存在本机）
config.json

# 运行时数据：词库、学习记录、浏览器配置、自动备份
data/

# 虚拟环境与 Python 缓存
.venv/
__pycache__/
*.py[cod]

# 打包产物
build/
dist/
*.exe
# 发布用的可执行文件要进仓库（上面这行排除的是其它构建产物）
!zhuxuan-v*.exe

# 日志与临时文件
*.log
_icon_check.png

# 系统设置备份（含本机注册表信息）
backups_系统设置/

# 手工备份（有 git 之后就不需要了）
web/*.bak-*

# 界面截图（临时产物）
tests/screenshots/

# 开发日志的私人原版（含具体使用记录），公开仓库用中性版
开发日志-原始版.md

# 临时草稿（发布用的文案，不需要进仓库）
RELEASE_v*_文案.md
build_pack.log

# 本地备份与临时文件（不进版本库）
*.dark.bak
竹喧.exe.bak
.look.js.bak
